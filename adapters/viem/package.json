{
  "name": "@d402/viem",
  "version": "0.1.0",
  "private": true,
  "description": "Viem integration for d402.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "lint": "eslint src test"
  },
  "peerDependencies": {
    "d402": "^0.4.0",
    "viem": "^2.0.0"
  },
  "dependencies": {
    "@rakelabs/dpayments-sdk": "^0.2.1",
    "@rakelabs/viem-adapter": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "d402": "file:../..",
    "typescript": "^6.0.3",
    "viem": "2.55.19",
    "vitest": "^4.1.9"
  }
}
