{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "d402/*": ["dist/*/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "adapters/ethers/src/**/*.ts",
    "adapters/ethers/test/**/*.ts",
    "adapters/viem/src/**/*.ts",
    "adapters/viem/test/**/*.ts",
    "facilitator/src/**/*.ts",
    "eslint.config.js"
  ]
}
